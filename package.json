{
  "name": "motion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.509",
    "@remotion/fonts": "^4.0.509",
    "@remotion/google-fonts": "4.0.509",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.509",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.509",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "render:reel": "remotion render CardFlipReel out/CardFlipReel.mp4",
    "render:flip": "remotion render CardFlip out/CardFlip.mp4",
    "render:deck": "remotion render CardDeckReel out/CardDeckReel.mp4 --codec=h264 --crf=18",
    "render:phones": "remotion render PhoneCarousel out/PhoneCarousel.mp4 --codec=h264 --crf=18",
    "render:phones:gif": "./scripts/render-gif.sh PhoneCarousel out/PhoneCarousel.gif 720 15",
    "render:promo": "remotion render PhoneCarouselBranded out/TalBoss-Promo.mp4 --codec=h264 --crf=18",
    "render:promo:gif": "./scripts/render-gif.sh PhoneCarouselBranded out/TalBoss-Promo.gif 1080 15",
    "render:deckpromo": "remotion render DeckPromo out/TalBoss-DeckPromo.mp4 --codec=h264 --crf=18",
    "render:deckpromo:gif": "./scripts/render-gif.sh DeckPromo out/TalBoss-DeckPromo.gif 1080 15",
    "render:swipe": "remotion render HiringSwipe out/HiringSwipe.mp4 --codec=h264 --crf=18",
    "render:swipe:gif": "./scripts/render-gif.sh HiringSwipe out/HiringSwipe.gif 1080 25 25",
    "render:swipe:loop:gif": "PROPS='{\"motion\":\"marquee\"}' ./scripts/render-gif.sh HiringSwipe out/HiringSwipe-loop.gif 1080 25 25",
    "render:swipe:gif:light": "./scripts/render-gif.sh HiringSwipe out/HiringSwipe-light.gif 810 25 25",
    "render:ring": "remotion render TalentRing out/TalentRing.mp4 --codec=h264 --crf=18",
    "render:ring:gif": "./scripts/render-gif.sh TalentRing out/TalentRing.gif 1080 30",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
